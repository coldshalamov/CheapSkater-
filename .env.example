# Optional user agent override (else Playwright default is used)
USER_AGENT=

# Telegram (optional)
# Create a bot via @BotFather and use /getid to retrieve the chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SendGrid (Required for email alerts)
# Generate an API key and verified sender in the SendGrid dashboard.
SENDGRID_API_KEY=
SENDGRID_FROM=          # Validated sender email
SENDGRID_FROM_NAME=GloorBot Alerts
SENDGRID_TO=            # Optional: default recipient for system errors

# API key for securing the Ingest endpoint
CHEAPSKATER_INGEST_API_KEY=


LOG_LEVEL=
HTTP_PROXY=
HEALTHCHECK_VERIFY=   # optional; set to "false" to disable TLS cert verification for healthcheck pings

# ══════════════════════════════════════════════════════════════════════════════
# Authentication & Subscriptions
# ══════════════════════════════════════════════════════════════════════════════

# Session secret for cookie-based authentication (generate a random string)
CHEAPSKATER_SESSION_SECRET=your-secret-key-change-this

# Stripe Configuration (for paid subscriptions)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret (for handling subscription events)
# Get this from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription tiers
# Create products at https://dashboard.stripe.com/products
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

