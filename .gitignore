# Virtual environments
/.venv/
.playwright-profile/

# Python cache directories
__pycache__/
.pytest_cache/
.pytest_tmp/

# Local databases
# (track SQLite so Render gets the populated dashboard data)
#*.sqlite
*.db

# Application output directories
/logs/*
!/logs/.gitkeep
/outputs/*
!/outputs/.gitkeep

# Environment and system files
.env
.DS_Store

# Build artifacts
/dist/
/build/

# Optional IDE settings
/.vscode/
/.idea/

# Serena MCP internal files (keep project.yml)
/.serena/*
!/.serena/.gitignore
!/.serena/project.yml

# Stray logs outside /logs
*.log
.kilocode/mcp.json
nul
